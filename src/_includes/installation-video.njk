<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Librescoot</title>
  <meta name="description" content="{{ 'Videoanleitung für die Installation mit dem Librescoot-Installer.' if lang == 'de' else 'Video guide for installing with the Librescoot installer.' }}">
  <link rel="canonical" href="https://downloads.librescoot.org{{ installationVideo[lang].path }}">
  <link rel="alternate" hreflang="de" href="https://downloads.librescoot.org{{ installationVideo.de.path }}">
  <link rel="alternate" hreflang="en" href="https://downloads.librescoot.org{{ installationVideo.en.path }}">
  <link rel="icon" type="image/png" href="https://librescoot.org/images/favicon.png">
  <link rel="stylesheet" href="https://librescoot.org/fonts/fonts.css">
  <link rel="stylesheet" href="https://librescoot.org/style.css">
  <script>
    (function() {
      var theme = localStorage.getItem('theme');
      if (theme) document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <style>
    .video-page { padding: 3rem 0 5rem; min-height: calc(100vh - 150px); }
    .video-page h1 { margin: 1rem 0 0.5rem; font-family: var(--font-display); color: var(--text-primary); }
    .video-page p { color: var(--text-secondary); }
    .video-frame { width: 100%; max-width: 960px; aspect-ratio: 16 / 9; margin: 1.5rem 0; background: #111; border-radius: var(--radius-lg); overflow: hidden; }
    .video-frame iframe { width: 100%; height: 100%; border: 0; }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="nav-container">
      <div class="nav-brand">
        <a href="{{ '/en/' if lang == 'en' else '/' }}">
          <img src="/librescoot-logo-v3-full-downloads.png" alt="Librescoot downloads" class="logo-small">
        </a>
      </div>
      <ul class="nav-links">
        <li class="nav-item"><a href="{{ '/en/' if lang == 'en' else '/' }}">Downloads</a></li>
        <li class="nav-item"><a href="{{ installationVideo.de.path if lang == 'en' else installationVideo.en.path }}" rel="alternate" hreflang="{{ 'de' if lang == 'en' else 'en' }}">{{ 'DE' if lang == 'en' else 'EN' }}</a></li>
      </ul>
    </div>
  </nav>
  <main class="container video-page">
    <a href="{{ '/en/' if lang == 'en' else '/' }}">{{ '← Back to downloads' if lang == 'en' else '← Zurück zu den Downloads' }}</a>
    <h1>{{ title }}</h1>
    <p>{{ 'Follow the installation step by step in this video.' if lang == 'en' else 'Dieses Video führt dich Schritt für Schritt durch die Installation.' }}</p>
    <div class="video-frame">
      <iframe src="https://www.youtube-nocookie.com/embed/{{ installationVideo[lang].id }}" title="{{ title }}" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
    <p>{{ 'Video not loading?' if lang == 'en' else 'Video lädt nicht?' }} <a href="{{ installationVideo[lang].url }}" target="_blank" rel="noopener">{{ 'Watch on YouTube ↗' if lang == 'en' else 'Auf YouTube ansehen ↗' }}</a></p>
  </main>
</body>
</html>
