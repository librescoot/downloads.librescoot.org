{% if installerBeta.version %}
<details class="installer-beta">
    <summary><span class="installer-beta-badge">Beta</span> Installer v{{ installerBeta.version }}</summary>
    {% if betaLanguage == "en" %}
    <p>Preview version for testing. For normal installations, use the stable download above. See the release notes for details.</p>
    {% else %}
    <p>Vorabversion zum Testen. Für normale Installationen den stabilen Download oben verwenden. Details stehen in den Release Notes.</p>
    {% endif %}
    {% set betaPlatforms = installerBeta.assets | byPlatform %}
    <ul class="installer-beta-downloads">
        {% if betaPlatforms.windowsExe or betaPlatforms.windowsZip %}
        <li><strong>Windows (x64)</strong>:
            {% if betaPlatforms.windowsExe %}<a href="{{ betaPlatforms.windowsExe.url }}" class="windows-download">.exe</a>{% endif %}
            {% if betaPlatforms.windowsExe and betaPlatforms.windowsZip %} · {% endif %}
            {% if betaPlatforms.windowsZip %}<a href="{{ betaPlatforms.windowsZip.url }}" class="windows-download">.zip</a>{% endif %}
        </li>
        {% endif %}
        {% if betaPlatforms.macos %}<li><strong>macOS (Universal)</strong>: <a href="{{ betaPlatforms.macos.url }}">.dmg</a></li>{% endif %}
        {% if betaPlatforms.linuxAppImage or betaPlatforms.linux %}
        <li><strong>Linux (x64)</strong>:
            {% if betaPlatforms.linuxAppImage %}<a href="{{ betaPlatforms.linuxAppImage.url }}">AppImage</a>{% endif %}
            {% if betaPlatforms.linuxAppImage and betaPlatforms.linux %} · {% endif %}
            {% if betaPlatforms.linux %}<a href="{{ betaPlatforms.linux.url }}">.tar.gz</a>{% endif %}
        </li>
        {% endif %}
    </ul>
    <p class="installer-beta-meta"><a href="{{ installerBeta.releaseUrl }}">Release Notes</a></p>
</details>
{% endif %}
